<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>LloydsTracker</RootNamespace>
    <AssemblyName>LloydsTracker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.2.0</Version>
    <Company>Lloyds Digital</Company>
    <Product>Lloyds Tracker</Product>
    <AssemblyTitle>Lloyds Tracker</AssemblyTitle>

    <!-- Framework-dependent, single-file .exe — a small (~2-3 MB) binary. The .NET runtime
         (incl. WinForms + ICU) comes from the target PC, not the bundle, so the target needs
         the .NET 8 Desktop Runtime installed once:
             winget install Microsoft.DotNet.DesktopRuntime.8
         (Windows 11 doesn't ship it; the apphost shows a download prompt if it's missing.)

         Self-contained was the zero-install alternative but floored at ~59 MB — it bundles
         the whole runtime, and trimming (the only way to shrink that) isn't safe for
         WinForms + reflection-based System.Text.Json. So: framework-dependent for size.

         A RuntimeIdentifier is required for single-file publish. ReadyToRun precompiles the
         (tiny) app assemblies for a snappy start. InvariantGlobalization stays OFF so the
         Croatian (hr-HR) culture works — its data is provided by the installed runtime.
         (EnableCompressionInSingleFile is omitted: it only applies to self-contained.) -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
